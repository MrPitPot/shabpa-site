{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shabpa",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "shabpa.ir", "custom_domain": true },
    { "pattern": "www.shabpa.ir", "custom_domain": true }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
