{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shabpa",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "shabpa.ir", "custom_domain": true },
    { "pattern": "www.shabpa.ir", "custom_domain": true }
  ],
  "assets": {
    "directory": "public"
  }
}
