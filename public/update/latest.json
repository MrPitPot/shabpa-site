  "notes": { "fa": "\ud83d\udce3 \u0634\u0628\u200c\u067e\u0627 \u06f3\u066b\u06f1\u06f7 \u0645\u0646\u062a\u0634\u0631 \u0634\u062f\n\n\ud83c\udd95 \u062a\u0627\u0632\u0647\u200c\u0647\u0627\n\u2022 \ud83c\udfa8 \u0647\u0631 \u06f3\u06f0 \u062a\u0645 \u0627\u062e\u062a\u0635\u0627\u0635\u06cc \u0627\u0632 \u0627\u0648\u0644 \u06a9\u0634\u06cc\u062f\u0647 \u0634\u062f: \u0628\u0647\u200c\u062c\u0627\u06cc \u0634\u06a9\u0644\u200c\u0647\u0627\u06cc \u0633\u0627\u062f\u0647\u060c \u06cc\u0647 \u0646\u0642\u0627\u0634\u06cc \u06a9\u0627\u0645\u0644 \u0628\u0627 \u0627\u062c\u0632\u0627\u06cc \u0645\u062a\u062d\u0631\u06a9 (\u0628\u0631\u0641\u060c \u0634\u0639\u0644\u0647\u060c \u0645\u0627\u0647\u06cc\u060c \u0628\u0627\u0631\u0627\u0646\u060c \u0631\u0639\u062f \u0648 \u0628\u0631\u0642...)\n\u2022 \ud83d\udecd \u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u062a\u0645\u200c\u0647\u0627 \u0646\u0642\u0627\u0634\u06cc \u0647\u0631 \u062a\u0645 \u0631\u0648 \u0631\u0648\u06cc \u06a9\u0627\u0634\u06cc\u200c\u0647\u0627 \u0646\u0634\u0648\u0646 \u0645\u06cc\u200c\u062f\u0647\n\n\ud83d\udee0 \u0631\u0641\u0639 \u0628\u0627\u06af\n\u2022 \ud83d\udd24 \u0645\u062a\u0646\u200c\u0647\u0627 \u0631\u0648\u06cc \u0646\u0642\u0627\u0634\u06cc \u062a\u0645\u200c\u0647\u0627 \u062e\u0648\u0627\u0646\u0627 \u0645\u06cc\u200c\u0645\u0648\u0646\u0646 (\u0633\u0627\u06cc\u062f\u0628\u0627\u0631\u060c \u0639\u0646\u0648\u0627\u0646 \u0635\u0641\u062d\u0647\u060c \u067e\u0627\u0648\u0631\u0642\u06cc \u0648 \u06a9\u0627\u0631\u062a\u200c\u0647\u0627)\n\u2022 \ud83e\ude9e \u0646\u0642\u0627\u0634\u06cc \u062a\u0645\u200c\u0647\u0627 \u062a\u0648 \u062d\u0627\u0644\u062a \u0641\u0627\u0631\u0633\u06cc \u0622\u06cc\u0646\u0647\u200c\u0627\u06cc \u0646\u0645\u06cc\u200c\u0634\u062f\u061b \u0645\u0627\u0647\u06cc\u200c\u0647\u0627 \u062f\u0645\u200c\u0628\u0647\u200c\u062c\u0644\u0648 \u0634\u0646\u0627 \u0645\u06cc\u200c\u06a9\u0631\u062f\u0646\n\u2022 \ud83e\ude9f \u0627\u0648\u0631\u0644\u06cc \u062f\u06cc\u06af\u0647 \u06a9\u0644 \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0648 \u0642\u0641\u0644 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0647\u061b \u0642\u0628\u0644\u0627\u064b \u0645\u0648\u0642\u0639 \u067e\u06cc\u062f\u0627 \u06a9\u0631\u062f\u0646 \u0645\u0627\u0646\u06cc\u062a\u0648\u0631\u060c \u0645\u0646\u062a\u0638\u0631 \u062f\u0631\u0627\u06cc\u0648\u0631 \u06af\u0631\u0627\u0641\u06cc\u06a9 \u0645\u06cc\u200c\u0645\u0648\u0646\u062f \u0648 \u067e\u0646\u062c\u0631\u0647 \u06af\u0627\u0647\u06cc \u062a\u0627 \u06f3\u06f0 \u062b\u0627\u0646\u06cc\u0647 \u0645\u06cc\u200c\u0627\u06cc\u0633\u062a\u0627\u062f\n\u2022 \u23f1 \u0628\u0633\u062a\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0648 \u0639\u0648\u0636 \u06a9\u0631\u062f\u0646 \u0632\u0628\u0627\u0646 \u062f\u06cc\u06af\u0647 \u06f3 \u062a\u0627 \u06f5 \u062b\u0627\u0646\u06cc\u0647 \u0645\u0639\u0637\u0644 \u0646\u0645\u06cc\u200c\u0634\u0647\n\u2022 \ud83c\udfc5 \u0635\u0641\u062d\u0647\u200c\u06cc \u0645\u062f\u0627\u0644\u200c\u0647\u0627 \u062d\u062f\u0648\u062f \u06f4 \u0628\u0631\u0627\u0628\u0631 \u0633\u0631\u06cc\u0639\u200c\u062a\u0631 \u0628\u0627\u0632 \u0645\u06cc\u200c\u0634\u0647\n\n\ud83d\udca1 \u0646\u0648\u0631\u067e\u0631\u062f\u0627\u0632\u06cc\n\u2022 \u0647\u0631 \u062f\u0633\u062a\u06af\u0627\u0647 \u06cc\u0647 \u0645\u0633\u06cc\u0631 \u062c\u062f\u0627 \u0628\u0647 \u0633\u0631\u0648\u0631 \u0646\u0648\u0631 \u062f\u0627\u0631\u0647\u061b \u062f\u0633\u062a\u06af\u0627\u0647 \u06a9\u0646\u062f (\u0645\u062b\u0644 \u0631\u0645 \u0648 \u0645\u0627\u062f\u0631\u0628\u0648\u0631\u062f) \u062f\u06cc\u06af\u0647 \u0641\u0646 \u0648 \u0646\u0648\u0627\u0631 LED \u0631\u0648 \u0639\u0642\u0628 \u0646\u0645\u06cc\u200c\u0646\u062f\u0627\u0632\u0647\n\u2022 \u0631\u0645 \u0648 \u062f\u0633\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0633\u0631\u0648\u0631 \u0646\u0648\u0631 \u0646\u0645\u06cc\u200c\u0628\u06cc\u0646\u0647 \u0647\u0646\u0648\u0632 \u06a9\u0646\u062a\u0631\u0644 \u0646\u0645\u06cc\u200c\u0634\u0646", "en": "" }
