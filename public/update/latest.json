  "notes": { "fa": "\ud83d\udce3 \u0634\u0628\u200c\u067e\u0627 \u06f3.\u06f1\u06f3.\u06f0 \u0645\u0646\u062a\u0634\u0631 \u0634\u062f\n\n\u2728 \u062a\u0627\u0632\u0647\u200c\u0647\u0627\n\u2022 \ud83c\udfc5 \u0645\u062f\u0627\u0644\u060c \u067e\u064e\u0631 \u0648 \u0633\u0637\u062d: \u0647\u0631 \u06a9\u0627\u0631\u06cc \u0628\u0627 \u0634\u0628\u200c\u067e\u0627 \u0628\u06a9\u0646\u06cc \u067e\u064e\u0631 \u0648 \u0645\u062f\u0627\u0644 \u0645\u06cc\u200c\u062f\u0647 \u0648 \u0628\u06cc\u062f\u0627\u0631 \u0631\u0648 \u062a\u0627 \u0633\u0637\u062d \u06f1\u06f0\u06f0 \u0628\u0632\u0631\u06af \u0645\u06cc\u200c\u06a9\u0646\u0647. \u0633\u0642\u0641 \u0631\u0648\u0632\u0627\u0646\u0647 \u0646\u062f\u0627\u0631\u0647 \u0648\u0644\u06cc \u0647\u0631 \u0633\u0637\u062d \u0627\u0632 \u0642\u0628\u0644\u06cc \u0633\u062e\u062a\u200c\u062a\u0631\u0647.\n\u2022 \ud83e\udd47 \u06f8\u06f2 \u0645\u062f\u0627\u0644 \u0627\u0632 \u0628\u0631\u0646\u0632\u06cc \u062a\u0627 \u0627\u0641\u0633\u0627\u0646\u0647\u200c\u0627\u06cc (\u0622\u062e\u0631\u06cc\u0646 \u0631\u062f\u0647\u200c\u0647\u0627 \u0648\u0627\u0642\u0639\u0627\u064b \u0633\u062e\u062a\u0647) \u0648 \u06f8 \u0645\u062f\u0627\u0644 \u0645\u062e\u0641\u06cc\u061b \u0645\u0623\u0645\u0648\u0631\u06cc\u062a\u200c\u0647\u0627\u06cc \u0631\u0648\u0632\u0627\u0646\u0647 \u0648 \u0647\u0641\u062a\u06af\u06cc \u0648 \u0634\u0628\u200c\u0647\u0627\u06cc \u067e\u06cc\u0627\u067e\u06cc.\n\u2022 \ud83d\udd14 \u0646\u0648\u062a\u06cc\u0641 \u06a9\u0648\u0686\u06cc\u06a9 \u0645\u062f\u0627\u0644 \u062c\u062f\u06cc\u062f \u0628\u0627\u0644\u0627\u06cc \u0646\u0648\u0627\u0631 \u0648\u0638\u06cc\u0641\u0647\u061b \u0647\u06cc\u0686\u200c\u0648\u0642\u062a \u0648\u0633\u0637 \u0628\u0627\u0632\u06cc \u0645\u0632\u0627\u062d\u0645 \u0646\u0645\u06cc\u200c\u0634\u0647.\n\u2022 \ud83d\udcf8 \u0647\u0631 \u0645\u062f\u0627\u0644 \u0631\u0648 \u0628\u0647\u200c\u0634\u06a9\u0644 \u0627\u0633\u062a\u0648\u0631\u06cc (\u06f1\u06f0\u06f8\u06f0\u00d7\u06f1\u06f9\u06f2\u06f0) \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0646\u060c \u0628\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0627\u0632 \u0628\u06cc\u0646 \u06f1\u06f0 \u0637\u0631\u062d: \u0646\u0648\u0631\u0627\u0641\u06a9\u0646\u060c \u06a9\u0627\u0631\u062a \u06a9\u0644\u06a9\u0633\u06cc\u0648\u0646\u06cc\u060c \u062a\u0628\u0631\u06cc\u06a9 \u0628\u06cc\u062f\u0627\u0631\u060c \u067e\u0648\u0633\u062a\u0631\u060c \u0635\u0648\u0631\u062a \u0641\u0644\u06a9\u06cc\u060c \u062e\u0644\u0627\u0635\u0647\u200c\u06cc \u0645\u0627\u0647\u060c \u06a9\u0627\u0634\u06cc \u0627\u06cc\u0631\u0627\u0646\u06cc\u060c \u0622\u0631\u06a9\u06cc\u062f\u060c \u0639\u06a9\u0633 \u0627\u0632 \u0635\u0641\u062d\u0647 \u0648 \u06af\u0648\u0627\u0647\u06cc \u0627\u0641\u062a\u062e\u0627\u0631.\n\u2022 \ud83d\uded2 \u062a\u0628 \u00ab\u0641\u0631\u0648\u0634\u06af\u0627\u0647\u00bb (\u0628\u0647\u200c\u0632\u0648\u062f\u06cc).\n\u2022 \ud83e\udd89 \u0628\u06cc\u062f\u0627\u0631 \u0628\u0647 \u0647\u0645\u0648\u0646 \u0632\u0628\u0627\u0646\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u0646\u0648\u06cc\u0633\u06cc \u062c\u0648\u0627\u0628 \u0645\u06cc\u200c\u062f\u0647 (\u0641\u0627\u0631\u0633\u06cc \u0628\u0646\u0648\u06cc\u0633\u06cc \u0641\u0627\u0631\u0633\u06cc\u060c \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc \u0628\u0646\u0648\u06cc\u0633\u06cc \u0627\u0646\u06af\u0644\u06cc\u0633\u06cc).\n\u2022 \ud83d\ude04 \u062d\u062f\u0648\u062f \u06f6\u06f0 \u062c\u0648\u06a9 \u062a\u0627\u0632\u0647 \u0628\u062f\u0648\u0646 \u062a\u06a9\u0631\u0627\u0631\u060c \u0641\u06a9\u062a\u060c \u0646\u06a9\u062a\u0647\u060c \u0631\u0648\u062d\u06cc\u0647 \u062f\u0627\u062f\u0646\u060c \u0645\u0627\u0634\u06cc\u0646\u200c\u062d\u0633\u0627\u0628\u060c \u0633\u06a9\u0647 \u0648 \u062a\u0627\u0633\u060c \u0648 \u062c\u0648\u0627\u0628\u200c\u0647\u0627\u06cc\u06cc \u062f\u0631\u0628\u0627\u0631\u0647\u200c\u06cc \u0633\u0637\u062d\u060c \u06a9\u0627\u0631\u0647\u0627\u06cc \u0627\u0645\u0631\u0648\u0632\u060c \u0645\u062f\u062a \u0631\u0648\u0634\u0646 \u0628\u0648\u062f\u0646 \u0633\u06cc\u0633\u062a\u0645 \u0648 \u0641\u0636\u0627\u06cc \u062f\u06cc\u0633\u06a9.\n\n\ud83d\udee0 \u0631\u0641\u0639 \u0628\u0627\u06af\n\u2022 \u0645\u0631\u062d\u0644\u0647\u200c\u06cc \u00ab\u0628\u0647\u06cc\u0646\u0647\u200c\u0633\u0627\u0632\u06cc \u0628\u0627\u0632\u06cc\u00bb \u062a\u0648\u06cc \u062a\u0648\u0631 \u062f\u06cc\u06af\u0647 \u0686\u0634\u0645\u06a9 \u0646\u0645\u06cc\u200c\u0632\u0646\u0647 \u0648 \u0635\u0641\u062d\u0647 \u0631\u0648 \u0645\u062f\u0627\u0645 \u062f\u0648\u0628\u0627\u0631\u0647 \u0628\u0627\u0632 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0647.\n\n\ud83d\udd12 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc\n\u2022 \u0647\u0645\u0647\u200c\u06cc \u0645\u062f\u0627\u0644\u200c\u0647\u0627 \u0648 \u067e\u064e\u0631\u0647\u0627 \u0641\u0642\u0637 \u0631\u0648\u06cc \u0647\u0645\u06cc\u0646 \u06a9\u0627\u0645\u067e\u06cc\u0648\u062a\u0631 \u0634\u0645\u0631\u062f\u0647 \u0648 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u0634\u0646\u061b \u0686\u06cc\u0632\u06cc \u062c\u0627\u06cc\u06cc \u0641\u0631\u0633\u062a\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0647.", "en": "Shabpa 3.13.0: medals, feathers and levels, story pictures, and Bidar answering in the language you write in." }
}
